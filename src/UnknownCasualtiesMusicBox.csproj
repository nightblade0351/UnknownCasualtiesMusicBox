<?xml version="1.0" encoding="utf-8"?>
<!--
  仅用于 IDE 参考（Visual Studio / Rider 语法着色）。
  实际构建请使用仓库根目录的 build.ps1（离线 csc，本机 dotnet 无法离线还原 net472 引用包）。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>UnknownCasualtiesMusicBox</AssemblyName>
    <RootNamespace>UCMB</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">D:\Application\游戏\Casualties Unknown V1.0.2</GameDir>
    <ManagedDir>$(GameDir)\CasualtiesUnknown_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <PluginsDir>$(GameDir)\BepInEx\plugins</PluginsDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="CUCoreLib">
      <HintPath>$(PluginsDir)\CUCoreLib.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>